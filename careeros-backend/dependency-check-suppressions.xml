<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppression file.

  Rules (see docs/DEPENDENCY_SECURITY.md):
    1. A suppression is allowed only for a confirmed false positive or a
       vulnerability that is not reachable in CareerOS, with a written
       justification.
    2. Every suppression MUST carry an `until` date. Expired suppressions are
       removed/re-reviewed; dependency-check reports them as expired.
    3. Never suppress to make CI green without review, and never suppress a
       HIGH/CRITICAL finding that is reachable.
    4. Do not use `<cvssBelow>` blanket suppressions.

  The three rules below cover HIGH/CRITICAL findings whose fixed release is
  not yet published on Maven Central (verified against maven-metadata.xml on
  2026-11-05). They are removed as soon as Spring Boot 3.5.x / Spring AI 1.1.x
  ship the next patch, which will be picked up by the version properties in
  pom.xml.

  Dependency-Check attributes Spring CVEs to every jar that matches the
  product CPE, so a finding can surface on a sibling jar (for example
  spring-tx, spring-security-web or spring-ai-retry) instead of the module
  that contains the vulnerable class. The packageUrl patterns therefore
  match the whole artifact family.
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
      Spring Framework 6.2.20 is not yet released (6.2.19 is the latest on
      Maven Central). CareerOS is a servlet Spring MVC application that does
      not use XSLT views, SSE, the functional web framework, FreeMarker,
      RSocket, SpEL evaluation of user input, WebFlux endpoints/WebSocket or
      @ModelAttribute data binding. The only reactive component is the
      WebClient used internally by the Spring AI HTTP clients (JSON only),
      so the WebFlux/Aalto/multipart/SSE code paths below are not reachable.
    -->
    <suppress until="2027-01-31Z">
        <notes><![CDATA[
            Spring Framework 6.2.20 fixes these issues but is not published
            yet. Reviewed 2026-11-05: the vulnerable XSLT view, SSE, functional
            endpoint, FreeMarker, SpEL, RSocket, WebFlux and data-binding code
            paths are not used by this servlet-based application. Re-review
            when 6.2.20 is available.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework/spring-.*@.*$</packageUrl>
        <cve>CVE-2026-47884</cve>
        <cve>CVE-2026-47885</cve>
        <cve>CVE-2026-47886</cve>
        <cve>CVE-2026-47888</cve>
        <cve>CVE-2026-47889</cve>
        <cve>CVE-2026-47890</cve>
        <cve>CVE-2026-47891</cve>
        <cve>CVE-2026-47892</cve>
        <cve>CVE-2026-47893</cve>
        <cve>CVE-2026-59282</cve>
        <cve>CVE-2026-59283</cve>
        <cve>CVE-2026-59313</cve>
    </suppress>

    <!--
      Spring Security 6.5.12 is not yet released (6.5.11 is the latest on
      Maven Central). CareerOS uses form/bearer JWT authentication only: it
      does not use the UnboundID LDAP test container, DPoP proof decoding,
      WebAuthn, or AesBytesEncryptor.
    -->
    <suppress until="2027-01-31Z">
        <notes><![CDATA[
            Spring Security 6.5.12 fixes these issues but is not published
            yet. Reviewed 2026-11-05: UnboundID LDAP container, DPoP, WebAuthn
            and AesBytesEncryptor are not on the classpath or used by the
            application. Re-review when 6.5.12 is available.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.security/spring-security-.*@.*$</packageUrl>
        <cve>CVE-2026-41707</cve>
        <cve>CVE-2026-47841</cve>
        <cve>CVE-2026-59270</cve>
    </suppress>

    <!--
      Spring AI 1.1.9 is not yet released (1.1.8 is the latest on Maven
      Central). CVE-2026-59318 (tool calling) is mitigated in
      CareerAssistantService: the model's tool calls are resolved against the
      per-request allowlist and unknown names are returned as an error instead
      of being executed. CVE-2026-47851 (PDF table-of-contents parsing) and
      CVE-2026-47852 (ONNX model cache) affect document readers / embedding
      models that CareerOS does not use.
    -->
    <suppress until="2027-01-31Z">
        <notes><![CDATA[
            Spring AI 1.1.9 fixes these issues but is not published yet.
            Reviewed 2026-11-05: tool dispatch is already allowlisted in
            CareerAssistantService.executeNativeTool, and the PDF/ONNX
            ingestion paths are not used. Re-review when 1.1.9 is available.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.ai/spring-ai-.*@.*$</packageUrl>
        <cve>CVE-2026-47851</cve>
        <cve>CVE-2026-47852</cve>
        <cve>CVE-2026-59318</cve>
    </suppress>

</suppressions>
